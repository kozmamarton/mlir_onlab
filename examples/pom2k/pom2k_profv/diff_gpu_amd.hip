#define HIP_CHECK(call)                                                     \
  do {                                                                      \
    hipError_t err_ = (call);                                               \
    if (err_ != hipSuccess) {                                               \
      std::fprintf(stderr, "%s:%d: %s failed: %s\n", __FILE__, __LINE__,    \
