namespace {

struct Config {
  long im = 1024, jm = 1024, kb = 20;
  int samples = 20;
  // Tolerance of the comparisons against the HIP reference; old vs new is
  // always bitwise.
  double rtol = 1e-5, atol = 1e-6;
  bool managed = false;
};

Config gConfig;

enum class Elem { F32, I32 };
enum class Extent { E2D, E3D };

struct ArgSpec {
  const char *name;
  Elem elem;
  Extent extent;
  uint64_t seed;
  bool selector;  // i32 selector: every element holds `selectorValue`
  int32_t selectorValue;
};

const ArgSpec kArgs[] = {
    {"etf", Elem::F32, Extent::E2D, 0x3f795a675d74a2a4ULL, false, 0},
    {"h", Elem::F32, Extent::E2D, 0x0ff31fe991702f3dULL, false, 0},
    {"c", Elem::F32, Extent::E3D, 0x78891c1aa3dbfa05ULL, false, 0},
    {"km", Elem::F32, Extent::E3D, 0x64a0cd6f65c7b8aaULL, false, 0},
    {"a", Elem::F32, Extent::E3D, 0xc37fb443ec921074ULL, false, 0},
    {"dz", Elem::F32, Extent::E3D, 0x238b5ef2a7ab2b54ULL, false, 0},
    {"dzz", Elem::F32, Extent::E3D, 0x89f2bc144ae9c644ULL, false, 0},
    {"ee", Elem::F32, Extent::E3D, 0xb067b98adc3d6f4aULL, false, 0},
    {"gg", Elem::F32, Extent::E3D, 0x99431f403e474213ULL, false, 0},
    {"wvsurf", Elem::F32, Extent::E2D, 0xe8a492ffdb2ff2d0ULL, false, 0},
    {"vf", Elem::F32, Extent::E3D, 0xb21a7c5edd6adb29ULL, false, 0},
    {"tps", Elem::F32, Extent::E2D, 0xb893c7602417bb52ULL, false, 0},
    {"cbc", Elem::F32, Extent::E2D, 0x44f78fbc609f9c2fULL, false, 0},
    {"ub", Elem::F32, Extent::E3D, 0x9ebd1a91e495c3e8ULL, false, 0},
    {"vb", Elem::F32, Extent::E3D, 0xb263af485a74734fULL, false, 0},
    {"dvm", Elem::F32, Extent::E3D, 0xca8fe39272b7b7d2ULL, false, 0},
    {"wvbot", Elem::F32, Extent::E2D, 0x5b21c68fb6f67898ULL, false, 0},
    {"dhloc", Elem::F32, Extent::E2D, 0x61b906c83e779f76ULL, false, 0},
};
constexpr int kNumArgs = sizeof(kArgs) / sizeof(kArgs[0]);

enum Variant { OLD, NEW, HIP, NUM_VARIANTS };
const char *const kVariantNames[NUM_VARIANTS] = {"old", "new", "hip"};

uint64_t mix(uint64_t x) {
  x += 0x9e3779b97f4a7c15ULL;
  x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
  x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
  return x ^ (x >> 31);
}

// Deterministic value in [0.5, 1.5).
float unitValue(uint64_t seed, uint64_t index) {
  return 0.5f + static_cast<float>(mix(seed ^ mix(index)) >> 40) *
                    (1.0f / 16777216.0f);
}

// Host copy of an array: the raw bits of its f32 or i32 elements.
using HostArray = std::vector<uint32_t>;

// One array in GPU memory: hipMalloc (device) or hipMallocManaged.
struct GpuArray {
  void *data = nullptr;
  size_t count = 0;

  GpuArray() = default;
  GpuArray(const GpuArray &) = delete;
  GpuArray &operator=(const GpuArray &) = delete;
  GpuArray(GpuArray &&o) noexcept { *this = std::move(o); }
  GpuArray &operator=(GpuArray &&o) noexcept {
    std::swap(data, o.data);
    std::swap(count, o.count);
    return *this;
  }
  ~GpuArray() {
    if (data)
      (void)hipFree(data);
  }

  size_t bytes() const { return count * 4; }
  void allocate(size_t n, bool managed) {
    HIP_CHECK(managed ? hipMallocManaged(&data, n * 4) : hipMalloc(&data, n * 4));
    count = n;
  }
};

size_t extentCount(const Config &cfg, Extent e) {
  size_t n2 = static_cast<size_t>(cfg.im) * static_cast<size_t>(cfg.jm);
  return e == Extent::E3D ? n2 * static_cast<size_t>(cfg.kb) : n2;
}

HostArray makeInput(const Config &cfg, const ArgSpec &spec) {
  HostArray a(spec.selector ? 1 : extentCount(cfg, spec.extent));
  const long long n = static_cast<long long>(a.size());
  if (spec.elem == Elem::I32) {
    for (long long i = 0; i < n; ++i)
      a[i] = static_cast<uint32_t>(spec.selectorValue);
    return a;
  }
#pragma omp parallel for
  for (long long i = 0; i < n; ++i) {
    const float v = unitValue(spec.seed, static_cast<uint64_t>(i));
    std::memcpy(&a[i], &v, 4);
  }
  return a;
}

uint64_t contentHash(const HostArray &a) {
  const long long n = static_cast<long long>(a.size());
  uint64_t h = 0;
#pragma omp parallel for reduction(^ : h)
  for (long long i = 0; i < n; ++i)
    h ^= mix((static_cast<uint64_t>(i) << 32) ^ a[i]);
  return h;
}

void upload(GpuArray &g, const HostArray &h) {
  HIP_CHECK(hipMemcpy(g.data, h.data(), g.bytes(), hipMemcpyDefault));
}

void download(HostArray &h, const GpuArray &g) {
  HIP_CHECK(hipMemcpy(h.data(), g.data, g.bytes(), hipMemcpyDefault));
}

void setGlobals(const Config &cfg) {
  dti2[0] = unitValue(0x311db1740b6ed16eULL, 0);
  im[0] = static_cast<int>(cfg.im);
  imm1[0] = static_cast<int>(cfg.im - 1);
  jm[0] = static_cast<int>(cfg.jm);
  jmm1[0] = static_cast<int>(cfg.jm - 1);
  kb[0] = static_cast<int>(cfg.kb);
  kbm1[0] = static_cast<int>(cfg.kb - 1);
  kbm2[0] = static_cast<int>(cfg.kb - 2);
  umol[0] = unitValue(0x701b698d5c833fd5ULL, 0);
}

void printGlobals() {
  std::printf("global dti2 = %.9g\n", dti2[0]);
  std::printf("global im = %d\n", im[0]);
  std::printf("global imm1 = %d\n", imm1[0]);
  std::printf("global jm = %d\n", jm[0]);
  std::printf("global jmm1 = %d\n", jmm1[0]);
  std::printf("global kb = %d\n", kb[0]);
  std::printf("global kbm1 = %d\n", kbm1[0]);
  std::printf("global kbm2 = %d\n", kbm2[0]);
  std::printf("global umol = %.9g\n", umol[0]);
}

void callKernel(int variant, std::vector<GpuArray> &b) {
  setGlobals(gConfig);
  switch (variant) {
  case OLD:
    ext_profv__old(b[0].data, b[0].data, 0, static_cast<int64_t>(b[0].count), 1,
        b[1].data, b[1].data, 0, static_cast<int64_t>(b[1].count), 1,
        b[2].data, b[2].data, 0, static_cast<int64_t>(b[2].count), 1,
        b[3].data, b[3].data, 0, static_cast<int64_t>(b[3].count), 1,
        b[4].data, b[4].data, 0, static_cast<int64_t>(b[4].count), 1,
        b[5].data, b[5].data, 0, static_cast<int64_t>(b[5].count), 1,
        b[6].data, b[6].data, 0, static_cast<int64_t>(b[6].count), 1,
        b[7].data, b[7].data, 0, static_cast<int64_t>(b[7].count), 1,
        b[8].data, b[8].data, 0, static_cast<int64_t>(b[8].count), 1,
        b[9].data, b[9].data, 0, static_cast<int64_t>(b[9].count), 1,
        b[10].data, b[10].data, 0, static_cast<int64_t>(b[10].count), 1,
        b[11].data, b[11].data, 0, static_cast<int64_t>(b[11].count), 1,
        b[12].data, b[12].data, 0, static_cast<int64_t>(b[12].count), 1,
        b[13].data, b[13].data, 0, static_cast<int64_t>(b[13].count), 1,
        b[14].data, b[14].data, 0, static_cast<int64_t>(b[14].count), 1,
        b[15].data, b[15].data, 0, static_cast<int64_t>(b[15].count), 1,
        b[16].data, b[16].data, 0, static_cast<int64_t>(b[16].count), 1,
        b[17].data, b[17].data, 0, static_cast<int64_t>(b[17].count), 1);
    break;
  case NEW:
    ext_profv__new(b[0].data, b[0].data, 0, static_cast<int64_t>(b[0].count), 1,
        b[1].data, b[1].data, 0, static_cast<int64_t>(b[1].count), 1,
        b[2].data, b[2].data, 0, static_cast<int64_t>(b[2].count), 1,
        b[3].data, b[3].data, 0, static_cast<int64_t>(b[3].count), 1,
        b[4].data, b[4].data, 0, static_cast<int64_t>(b[4].count), 1,
        b[5].data, b[5].data, 0, static_cast<int64_t>(b[5].count), 1,
        b[6].data, b[6].data, 0, static_cast<int64_t>(b[6].count), 1,
        b[7].data, b[7].data, 0, static_cast<int64_t>(b[7].count), 1,
        b[8].data, b[8].data, 0, static_cast<int64_t>(b[8].count), 1,
        b[9].data, b[9].data, 0, static_cast<int64_t>(b[9].count), 1,
        b[10].data, b[10].data, 0, static_cast<int64_t>(b[10].count), 1,
        b[11].data, b[11].data, 0, static_cast<int64_t>(b[11].count), 1,
        b[12].data, b[12].data, 0, static_cast<int64_t>(b[12].count), 1,
        b[13].data, b[13].data, 0, static_cast<int64_t>(b[13].count), 1,
        b[14].data, b[14].data, 0, static_cast<int64_t>(b[14].count), 1,
        b[15].data, b[15].data, 0, static_cast<int64_t>(b[15].count), 1,
        b[16].data, b[16].data, 0, static_cast<int64_t>(b[16].count), 1,
        b[17].data, b[17].data, 0, static_cast<int64_t>(b[17].count), 1);
    break;
  default:
    ext_profv__hip(static_cast<float *>(b[0].data),
        static_cast<float *>(b[1].data),
        static_cast<float *>(b[2].data),
        static_cast<float *>(b[3].data),
        static_cast<float *>(b[4].data),
        static_cast<float *>(b[5].data),
        static_cast<float *>(b[6].data),
        static_cast<float *>(b[7].data),
        static_cast<float *>(b[8].data),
        static_cast<float *>(b[9].data),
        static_cast<float *>(b[10].data),
        static_cast<float *>(b[11].data),
        static_cast<float *>(b[12].data),
        static_cast<float *>(b[13].data),
        static_cast<float *>(b[14].data),
        static_cast<float *>(b[15].data),
        static_cast<float *>(b[16].data),
        static_cast<float *>(b[17].data));
    break;
  }
  // The MLIR entry points synchronize after every launch; this surfaces
  // asynchronous faults of any variant right after its call.
  HIP_CHECK(hipDeviceSynchronize());
}

std::vector<GpuArray> allocateSet(const Config &cfg, const std::vector<HostArray> &inputs) {
  std::vector<GpuArray> set(kNumArgs);
  for (int i = 0; i < kNumArgs; ++i)
    set[i].allocate(inputs[i].size(), cfg.managed || kArgs[i].selector);
  return set;
}

double elapsedMs(std::chrono::steady_clock::time_point a,
                 std::chrono::steady_clock::time_point b) {
  return std::chrono::duration<double, std::milli>(b - a).count();
}

bool parseArgs(int argc, char **argv, Config &cfg) {
  for (int i = 1; i < argc; ++i) {
    std::string arg = argv[i];
    if (arg == "--size" && i + 1 < argc) {
      if (std::sscanf(argv[++i], "%ldx%ldx%ld", &cfg.im, &cfg.jm, &cfg.kb) != 3 ||
          cfg.im < 3 || cfg.jm < 3 || cfg.kb < 3) {
        std::fprintf(stderr, "invalid --size '%s' (expected IMxJMxKB, each >= 3)\n", argv[i]);
        return false;
      }
    } else if (arg == "--samples" && i + 1 < argc) {
      cfg.samples = std::atoi(argv[++i]);
      if (cfg.samples < 1) {
        std::fprintf(stderr, "invalid --samples\n");
        return false;
      }
    } else if ((arg == "--rtol" || arg == "--atol") && i + 1 < argc) {
      char *end = nullptr;
      const double value = std::strtod(argv[++i], &end);
      if (*end != '\0' || !(value >= 0)) {
        std::fprintf(stderr, "invalid %s '%s'\n", arg.c_str(), argv[i]);
        return false;
      }
      (arg == "--rtol" ? cfg.rtol : cfg.atol) = value;
    } else if (arg == "--memory" && i + 1 < argc) {
      const std::string mode = argv[++i];
      if (mode != "device" && mode != "managed") {
        std::fprintf(stderr, "invalid --memory '%s' (expected device or managed)\n", argv[i]);
        return false;
      }
      cfg.managed = mode == "managed";
    } else {
      std::fprintf(stderr,
                   "usage: %s [--size IMxJMxKB] [--samples N] [--rtol R] [--atol A] "
                   "[--memory device|managed]\n",
                   argv[0]);
      return false;
    }
  }
  return true;
}

struct PairDiff {
  size_t mismatches = 0;  // bitwise
  size_t failures = 0;    // beyond tolerance (= mismatches when bitwise)
  size_t first = 0;       // flat index of the first failure
  double maxAbs = 0.0, maxRel = 0.0;
};

// Without a tolerance every bitwise difference fails; with one, f32 elements
// fail when |a - b| > atol + rtol * max(|a|, |b|) or either is not finite.
PairDiff compare(const ArgSpec &s, const HostArray &x, const HostArray &y, bool tolerant) {
  PairDiff d;
  for (size_t k = 0; k < x.size(); ++k) {
    if (x[k] == y[k])
      continue;
    ++d.mismatches;
    bool fails = true;
    if (s.elem == Elem::F32) {
      float a, b;
      std::memcpy(&a, &x[k], 4);
      std::memcpy(&b, &y[k], 4);
      if (std::isfinite(a) && std::isfinite(b)) {
        double diff = std::fabs(static_cast<double>(a) - b);
        d.maxAbs = std::max(d.maxAbs, diff);
        double m = std::max(std::fabs(static_cast<double>(a)), std::fabs(static_cast<double>(b)));
        if (m > 0)
          d.maxRel = std::max(d.maxRel, diff / m);
        fails = !tolerant || diff > gConfig.atol + gConfig.rtol * m;
      }
    }
    if (fails && d.failures++ == 0)
      d.first = k;
  }
  return d;
}

}  // namespace

int main(int argc, char **argv) {
  if (!parseArgs(argc, argv, gConfig))
    return 2;
  const Config &cfg = gConfig;
  setGlobals(cfg);

  int device = 0;
  HIP_CHECK(hipGetDevice(&device));
  hipDeviceProp_t prop;
  HIP_CHECK(hipGetDeviceProperties(&prop, device));
  const char *memory = cfg.managed ? "managed" : "device";

  std::printf("kernel: ext_profv_\ntarget: gpu_amd\n");
  std::printf("gpu: %s (%s, wave%d, device %d)\nmemory: %s\n", prop.name, prop.gcnArchName,
              prop.warpSize, device, memory);
  std::printf("size: im=%ld jm=%ld kb=%ld\nsamples: %d\n", cfg.im, cfg.jm,
              cfg.kb, cfg.samples);
  std::printf("compare: old/new bitwise, */hip rtol=%g atol=%g\n", cfg.rtol, cfg.atol);
  printGlobals();

  // `initial` keeps the inputs on the host; every variant runs on its own
  // GPU copy and its results are copied back into `results`.
  std::vector<HostArray> initial(kNumArgs);
  std::vector<uint64_t> initialHash(kNumArgs);
  for (int i = 0; i < kNumArgs; ++i) {
    initial[i] = makeInput(cfg, kArgs[i]);
    initialHash[i] = contentHash(initial[i]);
  }
  std::vector<std::vector<GpuArray>> sets;
  std::vector<std::vector<HostArray>> results(NUM_VARIANTS);
  for (int v = 0; v < NUM_VARIANTS; ++v) {
    sets.push_back(allocateSet(cfg, initial));
    for (int i = 0; i < kNumArgs; ++i)
      results[v].emplace_back(initial[i].size());
  }

  // Correctness run on fresh inputs.
  for (int v = 0; v < NUM_VARIANTS; ++v) {
    for (int i = 0; i < kNumArgs; ++i)
      upload(sets[v][i], initial[i]);
    callKernel(v, sets[v]);
    for (int i = 0; i < kNumArgs; ++i)
      download(results[v][i], sets[v][i]);
  }

  const int kPairs[3][2] = {{OLD, NEW}, {OLD, HIP}, {NEW, HIP}};
  int mismatchedPairs[3] = {0, 0, 0};
  std::vector<std::string> firstMismatches;
  std::vector<bool> written(kNumArgs, false);
  int mismatchedArrays = 0;
  // mm_*: bitwise mismatches; tol_*: mismatches beyond the tolerance.
  std::printf("\n%-4s %-12s %-4s %-4s %12s %12s %12s %12s %12s %12s %12s %12s %s\n",
              "arg", "name", "type", "ext", "elements", "mm_old_new", "mm_old_hip",
              "mm_new_hip", "tol_old_hip", "tol_new_hip", "max_abs", "max_rel",
              "written");
  for (int i = 0; i < kNumArgs; ++i) {
    const ArgSpec &s = kArgs[i];
    PairDiff d[3];
    bool any = false;
    double maxAbs = 0.0, maxRel = 0.0;
    for (int p = 0; p < 3; ++p) {
      const HostArray &x = results[kPairs[p][0]][i];
      const HostArray &y = results[kPairs[p][1]][i];
      d[p] = compare(s, x, y, kPairs[p][1] == HIP);
      if (d[p].failures) {
        any = true;
        ++mismatchedPairs[p];
        // Flat index split as ACC3 (i + j*im + k*im*jm).
        const size_t n = d[p].first;
        const size_t plane = static_cast<size_t>(cfg.im) * static_cast<size_t>(cfg.jm);
        char line[256];
        if (s.elem == Elem::F32) {
          float a, b;
          std::memcpy(&a, &x[n], 4);
          std::memcpy(&b, &y[n], 4);
          std::snprintf(line, sizeof line,
                        "first failure %s %s/%s: index %zu (i=%zu j=%zu k=%zu) %.9g vs %.9g",
                        s.name, kVariantNames[kPairs[p][0]], kVariantNames[kPairs[p][1]], n,
                        n % cfg.im, n % plane / cfg.im, n / plane, a, b);
        } else {
          std::snprintf(line, sizeof line, "first failure %s %s/%s: index %zu %d vs %d",
                        s.name, kVariantNames[kPairs[p][0]], kVariantNames[kPairs[p][1]], n,
                        static_cast<int>(x[n]), static_cast<int>(y[n]));
        }
        firstMismatches.push_back(line);
      }
      maxAbs = std::max(maxAbs, d[p].maxAbs);
      maxRel = std::max(maxRel, d[p].maxRel);
    }
    for (int v = 0; v < NUM_VARIANTS; ++v)
      written[i] = written[i] || contentHash(results[v][i]) != initialHash[i];
    if (any)
      ++mismatchedArrays;
    std::printf("%-4d %-12s %-4s %-4s %12zu %12zu %12zu %12zu %12zu %12zu %12.4g %12.4g %s\n",
                i, s.name, s.elem == Elem::F32 ? "f32" : "i32",
                s.selector ? "sel" : (s.extent == Extent::E3D ? "3D" : "2D"),
                initial[i].size(), d[0].mismatches, d[1].mismatches, d[2].mismatches,
                d[1].failures, d[2].failures, maxAbs, maxRel, written[i] ? "yes" : "no");
  }
  const bool pass = mismatchedArrays == 0;
  if (!firstMismatches.empty())
    std::printf("\n");
  for (const std::string &line : firstMismatches)
    std::printf("%s\n", line.c_str());
  std::printf("\nresult: %s (%d of %d arrays fail; old/new %d, old/hip %d, "
              "new/hip %d)\n", pass ? "PASS" : "FAIL", mismatchedArrays, kNumArgs,
              mismatchedPairs[0], mismatchedPairs[1], mismatchedPairs[2]);

  // Timing: written arrays are restored from `initial` before every call,
  // inputs stay as is; the copy and a device synchronization happen before the
  // clock starts, so the timed region only contains the call itself (which
  // synchronizes). One untimed warm-up call per variant; the variant that runs
  // first rotates between samples so none always gets the warmer state.
  auto timedCall = [&](int v) {
    for (int i = 0; i < kNumArgs; ++i)
      if (written[i])
        upload(sets[v][i], initial[i]);
    HIP_CHECK(hipDeviceSynchronize());
    auto t0 = std::chrono::steady_clock::now();
    callKernel(v, sets[v]);
    auto t1 = std::chrono::steady_clock::now();
    return elapsedMs(t0, t1);
  };
  for (int v = 0; v < NUM_VARIANTS; ++v)
    timedCall(v);
  std::vector<double> times[NUM_VARIANTS];
  for (int s = 0; s < cfg.samples; ++s)
    for (int r = 0; r < NUM_VARIANTS; ++r) {
      const int v = (s + r) % NUM_VARIANTS;
      times[v].push_back(timedCall(v));
    }
  auto avg = [](const std::vector<double> &v) {
    double sum = 0;
    for (double x : v)
      sum += x;
    return sum / static_cast<double>(v.size());
  };
  auto minOf = [](const std::vector<double> &v) {
    return *std::min_element(v.begin(), v.end());
  };
  auto median = [](std::vector<double> v) {
    std::sort(v.begin(), v.end());
    size_t n = v.size();
    return n % 2 ? v[n / 2] : 0.5 * (v[n / 2 - 1] + v[n / 2]);
  };
  double med[NUM_VARIANTS];
  for (int v = 0; v < NUM_VARIANTS; ++v) {
    med[v] = median(times[v]);
    std::printf("time_%s_ms: median %.3f avg %.3f min %.3f\n", kVariantNames[v],
                med[v], avg(times[v]), minOf(times[v]));
  }
  const double speedup = med[NEW] > 0 ? med[OLD] / med[NEW] : 0.0;
  const double speedupVsHip = med[NEW] > 0 ? med[HIP] / med[NEW] : 0.0;
  std::printf("speedup_new_vs_old (median): %.3f\n", speedup);
  std::printf("speedup_new_vs_hip (median): %.3f\n", speedupVsHip);
  std::printf("SUMMARY kernel=ext_profv_ status=%s mismatched_arrays=%d "
              "arrays=%d mm_old_new=%d mm_old_hip=%d mm_new_hip=%d "
              "old_median_ms=%.3f new_median_ms=%.3f hip_median_ms=%.3f "
              "speedup=%.3f speedup_new_vs_hip=%.3f memory=%s\n",
              pass ? "PASS" : "FAIL", mismatchedArrays, kNumArgs,
              mismatchedPairs[0], mismatchedPairs[1], mismatchedPairs[2],
              med[OLD], med[NEW], med[HIP], speedup, speedupVsHip, memory);
  return pass ? 0 : 1;
}
